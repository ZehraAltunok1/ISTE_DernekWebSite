                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Auto"
                  }
                }
              }
            }
          }
        },
        "AnnouncementsObjectPage": {
          "type": "Component",
          "id": "AnnouncementsObjectPage",
