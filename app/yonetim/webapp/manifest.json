              "navigation": {
                "SiteStats": {
                  "detail": {
                    "route": "SiteStatsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Auto"
                  }
                }
              }
            }
          }
        },
        "SiteStatsObjectPage": {
          "type": "Component",
          "id": "SiteStatsObjectPage",
