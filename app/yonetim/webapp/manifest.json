          "options": {
            "settings": {
              "contextPath": "/Announcements",
              "editableHeaderContent": false
            }
          }
        },
        "FaqsList": {
          "type": "Component",
          "id": "FaqsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Faqs",
